DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full"

JWT_SECRET="isi_secret_random_panjang"
FILE_ACCESS_SECRET="isi_secret_random_panjang_untuk_link_download_file"
FILE_ACCESS_TOKEN_EXPIRES_IN="15m"

# Optional.
# Kosongkan di Android emulator agar backend memakai host request dari app
# seperti http://10.0.2.2:3000. Isi saat production, contoh:
# PUBLIC_API_BASE_URL="https://ship-monitoring-be.vercel.app"
PUBLIC_API_BASE_URL=""

BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_dari_store_ship-monitoring-be-blob"

NODE_ENV="development"
PORT=3000
