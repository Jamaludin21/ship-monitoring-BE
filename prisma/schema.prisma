generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url TIDAK BOLEH ADA DI SINI LAGI
}

// Mendefinisikan Role Pengguna
enum Role {
  ADMIN
  MANAGER
  NAHKODA
}

// Mendefinisikan Status Pengajuan
enum Status {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role
  name      String
  createdAt DateTime @default(now())

  ships Ship[]
}

model Ship {
  id          String       @id @default(uuid())
  shipNumber  String       @unique
  name        String
  captainId   String
  captain     User         @relation(fields: [captainId], references: [id])
  submissions Submission[]
  locations   Location[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id                     String    @id @default(uuid())
  shipId                 String
  ship                   Ship      @relation(fields: [shipId], references: [id])
  captainName            String
  employeeCount          Int
  cargo                  String
  cargoAmount            String
  sailingPermitUrl       String
  callSignCertificateUrl String
  safetyCertificateUrl   String
  radioStationPermitUrl  String
  status                 Status    @default(PENDING)
  reviewNote             String?
  submittedAt            DateTime  @default(now())
  reviewedAt             DateTime?
  reviewedBy             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([shipId])
  @@index([status])
  @@index([submittedAt])
}

model Location {
  id        String   @id @default(uuid())
  shipId    String
  ship      Ship     @relation(fields: [shipId], references: [id])
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  @@index([shipId])
  @@index([createdAt])
}
