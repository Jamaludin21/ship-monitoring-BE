generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url TIDAK BOLEH ADA DI SINI LAGI
}

// Mendefinisikan Role Pengguna
enum Role {
  ADMIN
  MANAGER
  NAHKODA
}

// Mendefinisikan Status Pengajuan
enum Status {
  PENDING
  WAITING_MANAGER_VALIDATION
  APPROVED
  REJECTED
}

enum ManagerDecision {
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role
  name      String
  createdAt DateTime @default(now())

  ships              Ship[]
  adminVerifications AdminVerification[]
  managerValidations ManagerValidation[]
}

model Ship {
  id          String       @id @default(uuid())
  shipNumber  String       @unique
  name        String
  captainId   String
  captain     User         @relation(fields: [captainId], references: [id])
  submissions Submission[]
  locations   Location[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id                     String    @id @default(uuid())
  shipId                 String
  ship                   Ship      @relation(fields: [shipId], references: [id])
  captainName            String
  employeeCount          Int
  cargo                  String
  cargoAmount            String
  sailingPermitUrl       String
  callSignCertificateUrl String
  safetyCertificateUrl   String
  radioStationPermitUrl  String
  status                 Status    @default(PENDING)
  reviewNote             String?
  submittedAt            DateTime  @default(now())
  reviewedAt             DateTime?
  reviewedBy             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  arrivalInspection ArrivalInspection?
  adminVerification AdminVerification?
  managerValidation ManagerValidation?

  @@index([shipId])
  @@index([status])
  @@index([submittedAt])
}

model AdminVerification {
  id                      String   @id @default(uuid())
  submissionId            String   @unique
  verificationDocumentKey String?
  verificationDocumentUrl String?
  note                    String?
  verifiedBy              String
  verifiedAt              DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verifier   User       @relation(fields: [verifiedBy], references: [id])

  @@index([verifiedBy])
  @@index([verifiedAt])
}

model ManagerValidation {
  id                    String          @id @default(uuid())
  submissionId          String          @unique
  decision              ManagerDecision
  validationDocumentKey String?
  validationDocumentUrl String?
  note                  String?
  validatedBy           String
  validatedAt           DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  validator  User       @relation(fields: [validatedBy], references: [id])

  @@index([validatedBy])
  @@index([validatedAt])
  @@index([decision])
}

enum InspectionCondition {
  YES
  NO
}

model ArrivalInspection {
  id                    String                     @id @default(uuid())
  submissionId          String                     @unique
  submission            Submission                 @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  inspectionDocumentUrl String?
  responseLetterUrl     String?
  note                  String?
  checkedBy             String
  checkedAt             DateTime                   @default(now())
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  items                 NavigationInspectionItem[]

  @@index([checkedBy])
  @@index([checkedAt])
}

model NavigationInspectionItem {
  id           String              @id @default(uuid())
  inspectionId String
  inspection   ArrivalInspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemNo       Int
  question     String
  condition    InspectionCondition
  note         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([inspectionId, itemNo])
  @@index([inspectionId])
}

model Location {
  id        String   @id @default(uuid())
  shipId    String
  ship      Ship     @relation(fields: [shipId], references: [id])
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  @@index([shipId])
  @@index([createdAt])
}
