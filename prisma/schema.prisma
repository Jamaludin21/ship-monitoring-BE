generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url TIDAK BOLEH ADA DI SINI LAGI (disediakan oleh prisma.config.ts)
}

// Mendefinisikan Role Pengguna
enum Role {
  ADMIN
  MANAGER
  NAHKODA
}

// Mendefinisikan Status Pengajuan
enum Status {
  PENDING
  WAITING_MANAGER_VALIDATION
  APPROVED
  REJECTED
}

enum ManagerDecision {
  APPROVED
  REJECTED
}

enum InspectionCondition {
  YES
  NO
}

model User {
  id        String   @id @default(uuid()) @db.VarChar(36)
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  role      Role
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamp(3)

  ships              Ship[]
  adminVerifications AdminVerification[]
  managerValidations ManagerValidation[]
}

model Ship {
  id         String   @id @default(uuid()) @db.VarChar(36)
  shipNumber String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  captainId  String   @db.VarChar(36)
  captain    User     @relation(fields: [captainId], references: [id])
  createdAt  DateTime @default(now()) @db.Timestamp(3)
  updatedAt  DateTime @updatedAt @db.Timestamp(3)

  submissions Submission[]
  locations   Location[]
}

model Submission {
  id                     String    @id @default(uuid()) @db.VarChar(36)
  shipId                 String    @db.VarChar(36)
  ship                   Ship      @relation(fields: [shipId], references: [id])
  captainName            String    @db.VarChar(100)
  employeeCount          Int
  cargo                  String    @db.VarChar(150)
  cargoAmount            String    @db.VarChar(50)
  sailingPermitUrl       String    @db.VarChar(500)
  callSignCertificateUrl String    @db.VarChar(500)
  safetyCertificateUrl   String    @db.VarChar(500)
  radioStationPermitUrl  String    @db.VarChar(500)
  status                 Status    @default(PENDING)
  reviewNote             String?   @db.VarChar(500)
  submittedAt            DateTime  @default(now()) @db.Timestamp(3)
  reviewedAt             DateTime? @db.Timestamp(3)
  reviewedBy             String?   @db.VarChar(36)
  createdAt              DateTime  @default(now()) @db.Timestamp(3)
  updatedAt              DateTime  @updatedAt @db.Timestamp(3)

  arrivalInspection ArrivalInspection?
  adminVerification AdminVerification?
  managerValidation ManagerValidation?

  @@index([shipId])
  @@index([status])
  @@index([submittedAt])
}

model AdminVerification {
  id                      String   @id @default(uuid()) @db.VarChar(36)
  submissionId            String   @unique @db.VarChar(36)
  verificationDocumentKey String?  @db.VarChar(500)
  verificationDocumentUrl String?  @db.VarChar(500)
  note                    String?  @db.VarChar(500)
  verifiedBy              String   @db.VarChar(36)
  verifiedAt              DateTime @default(now()) @db.Timestamp(3)
  createdAt               DateTime @default(now()) @db.Timestamp(3)
  updatedAt               DateTime @updatedAt @db.Timestamp(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  verifier   User       @relation(fields: [verifiedBy], references: [id])

  @@index([verifiedBy])
  @@index([verifiedAt])
}

model ManagerValidation {
  id                    String          @id @default(uuid()) @db.VarChar(36)
  submissionId          String          @unique @db.VarChar(36)
  decision              ManagerDecision
  validationDocumentKey String?         @db.VarChar(500)
  validationDocumentUrl String?         @db.VarChar(500)
  note                  String?         @db.VarChar(500)
  validatedBy           String          @db.VarChar(36)
  validatedAt           DateTime        @default(now()) @db.Timestamp(3)
  createdAt             DateTime        @default(now()) @db.Timestamp(3)
  updatedAt             DateTime        @updatedAt @db.Timestamp(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  validator  User       @relation(fields: [validatedBy], references: [id])

  @@index([validatedBy])
  @@index([validatedAt])
  @@index([decision])
}

model ArrivalInspection {
  id                    String                     @id @default(uuid()) @db.VarChar(36)
  submissionId          String                     @unique @db.VarChar(36)
  submission            Submission                 @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  inspectionDocumentUrl String?                    @db.VarChar(500)
  responseLetterUrl     String?                    @db.VarChar(500)
  note                  String?                    @db.VarChar(500)
  checkedBy             String                     @db.VarChar(36)
  checkedAt             DateTime                   @default(now()) @db.Timestamp(3)
  createdAt             DateTime                   @default(now()) @db.Timestamp(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamp(3)
  items                 NavigationInspectionItem[]

  @@index([checkedBy])
  @@index([checkedAt])
}

model NavigationInspectionItem {
  id           String              @id @default(uuid()) @db.VarChar(36)
  inspectionId String              @db.VarChar(36)
  inspection   ArrivalInspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemNo       Int
  question     String              @db.VarChar(255)
  condition    InspectionCondition
  note         String?             @db.VarChar(500)
  createdAt    DateTime            @default(now()) @db.Timestamp(3)
  updatedAt    DateTime            @updatedAt @db.Timestamp(3)

  @@unique([inspectionId, itemNo])
  @@index([inspectionId])
}

model Location {
  id        String   @id @default(uuid()) @db.VarChar(36)
  shipId    String   @db.VarChar(36)
  ship      Ship     @relation(fields: [shipId], references: [id])
  latitude  Float    @db.DoublePrecision
  longitude Float    @db.DoublePrecision
  createdAt DateTime @default(now()) @db.Timestamp(3)

  @@index([shipId])
  @@index([createdAt])
}
